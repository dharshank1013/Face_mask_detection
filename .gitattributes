# Set default behavior to automatically normalize line endings
* text=auto

# Source code files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - prevent git from corrupting binaries
*.pt binary
*.pth binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
